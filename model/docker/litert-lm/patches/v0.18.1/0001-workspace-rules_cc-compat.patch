Backport upstream LiteRT-LM's WORKSPACE fix for the TensorFlow pinned by v0.18.1.

v0.18.1's WORKSPACE re-pins TensorFlow to a1179d3c (the "UPDATED = 2026-10-09"
block). That TensorFlow's tensorflow/workspace1.bzl loads
`compatibility_proxy_repo` from @rules_cc//cc:extensions.bzl, but an older
rules_cc declared earlier in this WORKSPACE wins over TensorFlow's 0.2.25, so
the build fails before analysis with:

  Error: file '@rules_cc//cc:extensions.bzl' does not contain symbol
  'compatibility_proxy_repo'

These are the same repository-setup changes upstream made on main (declare
bazel_skylib 1.9.0 first; call go_rules_dependencies() after tf_workspace3();
call bazel_features_deps() and compatibility_proxy_repo()). main's TensorFlow
pins the same bazel_skylib/rules_cc/bazel_features versions as a1179d3c. Only
Bazel repository resolution changes; LiteRT-LM, LiteRT and TensorFlow sources
are built as tagged. Drop this directory once a release builds unmodified.

--- a/WORKSPACE
+++ b/WORKSPACE
@@ -26,6 +26,18 @@
 
 load("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
 
+# Declared before `rules_shell_dependencies()` and `apple_rules_dependencies()`
+# because those macros also declare `bazel_skylib`, and the first declaration of
+# a repository wins. The pinned TensorFlow expects 1.9.0: its `@rules_cc` uses
+# the `scope` attribute on `bool_flag`, which older bazel_skylib releases do not
+# define. Keep this in sync with the version in TensorFlow's
+# `tensorflow/workspace3.bzl`.
+http_archive(
+    name = "bazel_skylib",
+    sha256 = "3b5b49006181f5f8ff626ef8ddceaa95e9bb8ad294f7b5d7b11ea9f7ddaf8c59",
+    urls = ["https://github.com/bazelbuild/bazel-skylib/releases/download/1.9.0/bazel-skylib-1.9.0.tar.gz"],
+)
+
 http_archive(
     name = "rules_shell",
     sha256 = "bc61ef94facc78e20a645726f64756e5e285a045037c7a61f65af2941f4c25e1",
@@ -139,10 +151,6 @@
     ],
 )
 
-load("@io_bazel_rules_go//go:deps.bzl", "go_rules_dependencies")
-
-go_rules_dependencies()
-
 # TensorFlow
 http_archive(
     name = "org_tensorflow",
@@ -162,6 +170,18 @@
 
 tf_workspace3()
 
+load("@bazel_features//:deps.bzl", "bazel_features_deps")
+
+bazel_features_deps()
+
+load("@rules_cc//cc:extensions.bzl", "compatibility_proxy_repo")

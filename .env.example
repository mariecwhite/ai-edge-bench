# Copy to .env and adjust. Compose reads this file automatically.
#
# Every value here is optional; the defaults in compose.yaml are used when a
# variable is unset. Record the values you used alongside any published result.

# Avoid repeating -f flags on every command:
#   COMPOSE_FILE=compose.yaml:compose/machines/epyc-7443p.yaml
# COMPOSE_FILE=compose.yaml:compose/machines/epyc-7443p.yaml

# ---- workload ---------------------------------------------------------------
AEB_PROMPT_TOKENS=1024
AEB_GEN_TOKENS=256
AEB_REPETITIONS=5
# Leave empty to let the harness derive threads from the cgroup CPU quota.
# AEB_THREADS=

# ---- models -----------------------------------------------------------------
# Both defaults are ungated on Hugging Face and need no token.
AEB_GGUF_REPO=ggml-org/gemma-4-E2B-it-GGUF
AEB_GGUF_FILE=gemma-4-E2B-it-Q4_0.gguf
AEB_LITERTLM_REPO=litert-community/gemma-4-E2B-it-litert-lm
AEB_LITERTLM_FILE=gemma-4-E2B-it.litertlm
# Required only for gated repos such as google/gemma-3n-*-litert-lm.
# HF_TOKEN=

# ---- pinned upstream revisions ----------------------------------------------
# Changing either of these changes results. Bump deliberately and re-run the
# whole matrix; do not compare across refs.
AEB_LLAMA_CPP_REF=b11259
AEB_LITERTLM_REF=v0.17.1

# ---- build ------------------------------------------------------------------
# 0 lets the build system choose. Bazel needs roughly 8 GB of RAM per job;
# lower this on memory-constrained hosts to avoid OOM during the LiteRT-LM build.
AEB_BUILD_JOBS=0

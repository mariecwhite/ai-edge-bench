{
  "name": "gemma4-e2b-cpu-sapphire-rapids",
  "description": "Gemma 4 E2B on x86 Sapphire Rapids CPU (Intel Xeon Platinum 8481C, Socket 0): OpenXLA (YNNPACK), LiteRT-LM (with YNNPACK and XNNPACK), llama.cpp (AVX-512 + AMX), OpenVINO GenAI, and ONNX Runtime GenAI across FP32, BF16, INT8, and INT4/INT2 model precisions. Frameworks are only benchmarked on data types where pre-built model artifacts exist (e.g., llama.cpp is omitted from FP32 because no pre-built F32 GGUF is published in ggml-org/gemma-4-E2B-it-GGUF).",
  "references": "references/gemma-4-E2B-it.json",
  "models": {
    "litertlm": "/models/litert-community/gemma-4-E2B-it-litert-lm/gemma-4-E2B-it.litertlm",
    "gguf_matched": "/models/aeb/gemma-4-E2B-it-qat-mobile-matched.gguf",
    "gguf_matched_q4": "/models/aeb/gemma-4-E2B-it-qat-mobile-matched-q4.gguf",
    "gguf_stock_q4_0": "/models/ggml-org/gemma-4-E2B-it-GGUF/gemma-4-E2B-it-Q4_0.gguf",
    "gguf_q8_0": "/models/ggml-org/gemma-4-E2B-it-GGUF/gemma-4-E2B-it-Q8_0.gguf",
    "gguf_bf16": "/models/ggml-org/gemma-4-E2B-it-GGUF/gemma-4-E2B-it-BF16.gguf",
    "hf_bf16": "/models/google/gemma-4-E2B-it",
    "hf_qat_mobile": "/models/google/gemma-4-E2B-it-qat-mobile-transformers",
    "ov_int4": "/models/OpenVINO/gemma-4-E2B-it-int4-ov",
    "ov_int8": "/models/OpenVINO/gemma-4-E2B-it-int8-ov",
    "ov_fp16": "/models/OpenVINO/gemma-4-E2B-it-fp16-ov",
    "onnx_q4_k_m": "/models/aeb/gemma-4-e2b-onnx/Q4_K_M/default"
  },
  "workload": {
    "prompt_tokens": 1024,
    "gen_tokens": 128,
    "warmup": 1,
    "repetitions": 3,
    "cooldown_s": 1,
    "ctx": 4096
  },
  "rounds": 2,
  "accuracy_select_fastest_by_dtype": true,
  "sequence_sweep": {
    "prompt_tokens": [
      64,
      256,
      1024,
      4096
    ],
    "gen_tokens": 128,
    "ctx": 8192,
    "rounds": 1,
    "warmup": 1,
    "repetitions": 2,
    "cooldown_s": 1,
    "select_fastest_by_dtype": true,
    "min_accuracy": {
      "mmlu": 0.4,
      "gsm8k": 0.4
    }
  },
  "repro": {
    "repeats": 2,
    "max_tokens": 64,
    "slots": [
      [
        "greedy",
        null,
        1.0,
        0
      ],
      [
        "greedy",
        null,
        1.0,
        1
      ],
      [
        "seeded",
        1234,
        1.0,
        0
      ],
      [
        "seeded",
        1234,
        1.0,
        1
      ],
      [
        "seeded",
        1235,
        1.0,
        3
      ]
    ],
    "only": [
      "llama.cpp/matched",
      "llama.cpp/fastest",
      "litert-lm/matched",
      "litert-lm/fastest",
      "xla/matched-ynnpack",
      "openvino/int4",
      "onnxruntime/q4_k_m"
    ]
  },
  "configs": [
    {
      "id": "llama.cpp/matched",
      "framework": "llama.cpp",
      "dtype": "int4",
      "track": "matched",
      "args": [
        "--model",
        "{gguf_matched}",
        "--threads",
        "{threads}",
        "--ctx",
        "{ctx}",
        "--flash-attn",
        "on",
        "--cache-type-k",
        "q8_0",
        "--cache-type-v",
        "q8_0"
      ],
      "accuracy": {
        "mmlu_limit": 2000,
        "gsm8k_limit": 250
      }
    },
    {
      "id": "litert-lm/matched",
      "framework": "litert-lm",
      "dtype": "int4",
      "track": "matched",
      "args": [
        "--model",
        "{litertlm}",
        "--threads",
        "{threads}",
        "--ctx",
        "{ctx}",
        "--cache-dir",
        "/results/_cache/litert-lm-xnnpack"
      ],
      "accuracy": {
        "mmlu_limit": 2000,
        "gsm8k_limit": 250
      }
    },
    {
      "id": "xla/matched-ynnpack",
      "framework": "xla",
      "dtype": "int4",
      "track": "matched",

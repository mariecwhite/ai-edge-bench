      "accuracy": {
        "mmlu_limit": 2000
      }
    },
    {
      "id": "xla/matched-onednn",
      "disabled": true,
      "_comment": "Disabled: XLA oneDNN custom-call rewriter fails on INT4 weight quantization (--dtype int4 --onednn).",
